<resources>
    <style name="Theme.LiteWalker.Light" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorAccent">@color/accent_teal</item>
    </style>

    <style name="Theme.LiteWalker.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/app_background_dark</item>
        <item name="android:windowBackground">@color/app_background_dark</item>
        <item name="android:colorAccent">@color/accent_teal_dark</item>
    </style>

    <style name="Theme.LiteWalker" parent="Theme.LiteWalker.Light" />
</resources>
